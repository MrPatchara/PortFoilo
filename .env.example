# ── Contact form (api/contact.ts) ────────────────────────────────────────────
# Required. API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Recipient(s) of contact-form emails — comma-separated for multiple addresses.
# Defaults to patcharaalumaree@gmail.com when omitted.
CONTACT_TO=patcharaalumaree@gmail.com

# Verified "from" address on Resend.
# Defaults to: Portfolio <onboarding@resend.dev>
# Use your own verified domain once it is added in the Resend dashboard.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
